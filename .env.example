# ==============================================================================
#  ATLAS — Environment Configuration
#  Copy this file to .env and fill in your values before running docker compose
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
#  DATABASE
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL / TimescaleDB
POSTGRES_DB=kernelx
POSTGRES_USER=kernelx
POSTGRES_PASSWORD=change_me_in_production

# ──────────────────────────────────────────────────────────────────────────────
#  JWT AUTHENTICATION (User Service)
#  Generate a secure 256-bit secret: openssl rand -hex 32
# ──────────────────────────────────────────────────────────────────────────────

JWT_SECRET=your_256bit_hex_secret_here_change_this_before_production
JWT_EXPIRATION=900000          # Access token TTL in ms  (default: 15 minutes)
JWT_REFRESH_EXPIRATION=86400000 # Refresh token TTL in ms (default: 1 day)

# ──────────────────────────────────────────────────────────────────────────────
#  REDIS
# ──────────────────────────────────────────────────────────────────────────────

REDIS_HOST=redis
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────────────────────
#  MQTT INGESTION SERVICE
# ──────────────────────────────────────────────────────────────────────────────

# MQTT Broker — use the public HiveMQ broker for testing,
# or replace with your own broker (e.g., Mosquitto, EMQX)
MQTT_BROKER=tcp://broker.hivemq.com:1883
MQTT_CLIENT_ID=atlas-mqtt-consumer
MQTT_TOPIC=thw/telemetry/#     # Change this to match your device topic
MQTT_QOS=1

# ──────────────────────────────────────────────────────────────────────────────
#  ALERTING SERVICE
# ──────────────────────────────────────────────────────────────────────────────

# How often to run the alert evaluation engine
ALERT_SCHEDULER_CRON=0 */1 * * * *   # Every 1 minute (cron expression)

# How far back to look for sensor readings in each evaluation cycle
ALERT_TIME_WINDOW_MINS=10

# How long to keep resolved alerts before deleting them
ALERT_RETENTION_DAYS=1

# ──────────────────────────────────────────────────────────────────────────────
#  INITIAL ADMIN ACCOUNT (seeded on first boot)
# ──────────────────────────────────────────────────────────────────────────────

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123   # CHANGE THIS in production!

# ──────────────────────────────────────────────────────────────────────────────
#  SERVICE PORTS (advanced — only change if you have port conflicts)
# ──────────────────────────────────────────────────────────────────────────────

PORT_FRONTEND=8090
PORT_MQTT_SERVICE=8091
PORT_METADATA_SERVICE=8092
PORT_ALERTING_SERVICE=8093
PORT_REPORT_SERVICE=8094
PORT_USER_SERVICE=8096
PORT_GIS_SERVICE=8097
PORT_POSTGRES=5432
PORT_REDIS=6379
